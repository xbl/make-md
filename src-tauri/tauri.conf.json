{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "make-md",
  "version": "0.1.0",
  "identifier": "com.make-md",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "make-md",
        "width": 1280,
        "height": 860,
        "resizable": true
      }
    ]
  }
}
